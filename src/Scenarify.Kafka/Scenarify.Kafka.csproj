<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <!-- Shares Scenarify's root namespace so a single "using Scenarify;" covers both packages. -->
        <RootNamespace>Scenarify</RootNamespace>
        <Description>Apache Kafka scenario steps for Scenarify: produce records and assert on produced records,
            with a KafkaFeature that starts alongside the service under test.</Description>
        <PackageTags>xunit;testing;integration-testing;kafka;apache-kafka;scenario-testing</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Scenarify\Scenarify.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Confluent.Kafka" Version="2.16.0" />
    </ItemGroup>

</Project>
