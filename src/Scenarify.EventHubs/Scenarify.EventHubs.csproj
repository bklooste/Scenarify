<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <!-- Shares Scenarify's root namespace so a single "using Scenarify;" covers both packages. -->
        <RootNamespace>Scenarify</RootNamespace>
        <Description>Azure Event Hubs scenario steps for Scenarify: publish/assert on Event Hub events,
            and an EventHubsFeature that starts alongside the service under test.</Description>
        <PackageTags>xunit;testing;integration-testing;azure;eventhubs;event-hubs;scenario-testing</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Scenarify\Scenarify.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Azure.Messaging.EventHubs" Version="5.12.2" />
    </ItemGroup>

</Project>
